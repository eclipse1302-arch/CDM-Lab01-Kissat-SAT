#==========================================================================#
# This is a 'makefile.in' template with '@CXX@' and '@CXXFLAGS@' parameters.
# This makefile requires GNU make.
#==========================================================================#

# The '../scripts/make-build-header.sh' script searches for the next two
# lines to figure out the compiler and compilation flags.  This information
# is then used to generate corresponding macros in 'build.hpp'.

CXX=@CXX@
CXXFLAGS=@CXXFLAGS@

CC=@CC@
CFLAGS=@CFLAGS@

LIBS=@LIBS@
CONTRIB=@CONTRIB@
IPASIR=@IPASIR@

############################################################################
#    It is usually not necessary to change anything below this line!       #
############################################################################

SRC_APP=coursesat.cpp modeltest.cpp

SRC_IPASIR=src/ipasir.cpp
SRC_SOLVER=$(subst ../src/,,$(sort $(wildcard ../src/*.cpp)))
SRC_CONTRIB=$(subst ../contrib/,,$(sort $(wildcard ../contrib/*.cpp)))
SRC_C=$(subst ../src/,,$(sort $(wildcard ../src/*.c)))

FILT_SOLVER=$(filter-out $(SRC_APP),$(SRC_SOLVER))
FILT_SOLVER:=$(if $(filter-out no,$(IPASIR)),$(FILT_SOLVER),$(filter-out $(SRC_IPASIR), $(FILT_SOLVER)))
FILT_CONTRIB=$(if $(filter-out no,$(CONTRIB)),$(SRC_CONTRIB),)
OBJ_SOLVER=$(FILT_SOLVER:.cpp=.o)
OBJ_CONTRIB=$(FILT_CONTRIB:.cpp=.o) $(SRC_C:.c=.o)

# Include for the current build directory is required for including the
# generated build header 'build.hpp'.

DIR=../$(shell pwd|sed -e 's,.*/,,')
COMPILE_CPP=$(CXX) $(CXXFLAGS) -I$(DIR) -I../src
COMPILE_CCC=$(CC) $(CFLAGS) -I$(DIR) -I../src

#--------------------------------------------------------------------------#

all: @GOALS@

#--------------------------------------------------------------------------#

.SUFFIXES: .cpp .o .c


%.o: ../*/%.c ../src/*.h makefile
	$(COMPILE_CCC) -x c -c $< -o $@


%.o: ../*/%.cpp ../src/*.hpp makefile
	$(COMPILE_CPP) -c $<

#--------------------------------------------------------------------------#

# Build the command-line solver and its library.

coursesat: coursesat.o libcoursesat.a makefile
	$(COMPILE_CPP) -o $@ $< -L. libcoursesat.a $(LIBS)

coursesat-dynamic: coursesat.o libcoursesat.so makefile
	$(COMPILE_CPP) -o $@ $< -L. libcoursesat.so $(LIBS)

libcoursesat.a: $(OBJ_SOLVER) $(OBJ_CONTRIB) makefile
	ar rc $@ $(OBJ_SOLVER) $(OBJ_CONTRIB)

libcoursesat.so: $(OBJ_SOLVER) $(OBJ_CONTRIB) $(LIBS) makefile
	$(COMPILE_CPP) -shared -o $@ $(OBJ_SOLVER) $(OBJ_CONTRIB) $(LIBS)

#--------------------------------------------------------------------------#

# Note that 'build.hpp' is generated and resides in the build directory.

build.hpp: always
	../scripts/make-build-header.sh > build.hpp

version.o: build.hpp

#--------------------------------------------------------------------------#

# These two 'C' interfaces include '.h' headers and thus require explicitly
# defined additional dependencies.

ccoursesat.o: ../src/ccoursesat.h
ipasir.o: ../src/ipasir.h ../src/ccoursesat.h


#--------------------------------------------------------------------------#

analyze: all
	$(COMPILE_CPP) --analyze ../src/*.cpp
	$(COMPILE_CPP) --analyze ../contrib/*.cpp

format:
	clang-format -i ../*/*.[ch]pp
	clang-format -i ../*/*.[ch]
	clang-format -i ../test/*/*.[ch]pp
	clang-format -i ../test/*/*.[ch]

clean:
	rm -f *.o *.a coursesat modeltest makefile build.hpp
	rm -f *.gcda *.gcno *.gcov gmon.out

test: part1_test

#--------------------------------------------------------------------------#

.PHONY: all always analyze clean test format

# Course targets: fail if certificate checker compilation fails.
part1_test: all
	$(CC) -O2 -o dimocheck ../test/cnf/dimocheck.c -lz
	$(CC) -O2 -o drat-trim ../test/cnf/drat-trim.c
	$(CC) -O2 -o lrat-trim ../test/cnf/lrat-trim.c
	cd ../test && COURSESATBUILD="$(DIR)" ./cnf/run.sh
	python3 ../scripts/check-public-regressions.py

handin:
	python3 ../scripts/handin.py

.PHONY: part1_test handin

part2_test: all
	$(CC) -O2 -o drat-trim ../test/cnf/drat-trim.c
	python3 ../scripts/test-performance.py

public_test: part1_test part2_test
.PHONY: part2_test public_test
